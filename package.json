{
  "name": "ai-workflow-kit",
  "version": "3.3.0",
  "description": "Skills, agents & hooks for Claude Code, Cursor, GitHub Copilot, Google Antigravity, OpenAI Codex, and Pi",
  "type": "module",
  "bin": {
    "ai-workflow-kit": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "skills/",
    "agents/",
    "hooks/",
    "antigravity-skills/",
    "codex-prompts/",
    "pi/",
    "templates/",
    "src/manifest.json",
    ".cursorrules",
    ".github/copilot-instructions.md",
    "README.es.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "skills": [
      "./pi/skills"
    ],
    "extensions": [
      "./pi/extensions/ak-hooks.ts"
    ]
  },
  "scripts": {
    "start": "npx node bin/cli.js",
    "build": "node scripts/build-skills.js && node scripts/sync-docs.js",
    "build:check": "node scripts/build-skills.js --check && node scripts/sync-docs.js --check",
    "test": "npm run build:check && vitest run evals/hooks evals/cli evals/pi",
    "test:watch": "vitest evals/hooks evals/cli evals/pi",
    "eval": "npx node evals/run-evals.js",
    "test:all": "vitest run evals/hooks evals/cli evals/pi && npx node evals/run-evals.js",
    "release:patch": "npx node scripts/release.js patch",
    "release:minor": "npx node scripts/release.js minor",
    "release:major": "npx node scripts/release.js major",
    "release:beta": "npx node scripts/release.js beta"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "vitest": "^3.1.1",
    "yaml": "^2.9.0"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "ai-coding",
    "skills",
    "agents",
    "hooks",
    "workflow",
    "pi-package"
  ],
  "author": "Bezael Pérez <me@dominicode.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bezael/ai-workflow-kit"
  },
  "engines": {
    "node": ">=18"
  }
}
